# Supabase Configuration
# Credenciais do seu projeto GV-Solucoes

# PASSO 1: Vá para https://app.supabase.com
# PASSO 2: Selecione o projeto "GV-Solucoes"
# PASSO 3: Vá para Settings > API
# PASSO 4: Copie:

# A URL (supabase url) - de Settings > API > Project URL
VITE_SUPABASE_URL=https://oonschyrkzjohowyiolg.supabase.co

# A Chave Pública (anon key) - de Settings > API > Project API keys > anon public
# Abra https://app.supabase.com/project/oonschyrkzjohowyiolg/settings/api
# Copie a chave "anon" ou "public" e cole aqui:
VITE_SUPABASE_ANON_KEY=https://oonschyrkzjohowyiolg.supabase.co/rest/v1/
# Ambiente
VITE_ENV=development
